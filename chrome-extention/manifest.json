{
  "manifest_version": 3,
  "name": "EasyData MCP Connector",
  "version": "2.0",
  "description": "Connects Gemini and Claude with the EasyData MCP server via context menus and static content scripts.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "https://easydata.is/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    { 
      "matches": [
        "https://gemini.google.com/*",
        "https://aistudio.google.com/*",
        "https://claude.ai/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
